# AgriMitra Backend Environment Template

APP_NAME="AgriMitra Backend"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agrimitra
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agrimitra_db
DATABASE_URL=postgresql+asyncpg://agrimitra:postgres@localhost:5432/agrimitra_db

# Logging
LOG_LEVEL=INFO
